# -----------------------------------------------------------------------------
# 11:11 Decor — Environment Variables Template
# Copy this file to .env.local for local development or set in your build pipeline.
# -----------------------------------------------------------------------------

# Public Base URL for canonical URLs, XML sitemaps, and robots.txt
# (Do not include trailing slash)
NEXT_PUBLIC_SITE_URL=https://elevenelevendecor.com

# Optional: Custom API Base URL if the PHP backend is hosted on a separate subdomain or port
# (Default is empty string "" which uses relative path /api/* on the same host)
NEXT_PUBLIC_API_URL=

# Environment Mode
NODE_ENV=development
