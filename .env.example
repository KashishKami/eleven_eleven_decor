# -----------------------------------------------------------------------------
# 11:11 Decor — Environment Variables Template
# Copy this file to .env.local for local development or set in your build pipeline.
# -----------------------------------------------------------------------------

# Public Base URL for canonical URLs, XML sitemaps, and robots.txt
# (Do not include trailing slash)
NEXT_PUBLIC_SITE_URL=https://elevenelevendecor.com

# Contact Form PHP Endpoint — full URL to contact.php
#
# Local development (PHP dev server root is php-admin/, so path = /api/contact.php):
#   NEXT_PUBLIC_CONTACT_API_URL=http://127.0.0.1:8080/api/contact.php
#
# GoDaddy production (php-admin/ lives inside public_html/, so path is deeper):
#   NEXT_PUBLIC_CONTACT_API_URL=https://YOUR-REAL-DOMAIN.com/php-admin/api/contact.php
#
# If this variable is not set, the form defaults to the local dev URL automatically.
NEXT_PUBLIC_CONTACT_API_URL=http://127.0.0.1:8080/api/contact.php

# Optional: Custom API Base URL if the PHP backend is hosted on a separate subdomain or port
# (Default is empty string "" which uses relative path /api/* on the same host)
NEXT_PUBLIC_API_URL=

# Environment Mode
NODE_ENV=development
